# OMOP Pregnancy - unified environment template
# Copy this file to .env in the project root and fill in the section for
# your platform. Lines starting with # are ignored. Never commit .env.
#
# Platform-specific templates with more commentary are alongside this file:
#   .env.sqlserver.template, .env.sqlserver_windows.template,
#   .env.sqlserver_crossdb.template, .env.databricks.template

# ---------------------------------------------------------------------------
# Platform: "sql server", "postgresql", or "databricks"
# ---------------------------------------------------------------------------
DB_TYPE=sql server

# Java (optional; set if JDBC needs a specific JVM)
# JAVA_HOME=/path/to/java/home

# JDBC drivers folder (run inst/scripts/setup_jdbc_drivers.R to populate)
JDBC_DRIVER_PATH=./jdbc_drivers

# ---------------------------------------------------------------------------
# Connection
# ---------------------------------------------------------------------------
DB_SERVER=your-server.domain.com
DB_DATABASE=OMOP_CDM
# DB_PORT=1433            # defaults: sql server 1433, postgresql 5432, databricks 443

# SQL authentication (leave blank for Windows AD; see below)
DB_USER=your_username
DB_PASSWORD=your_password

# SQL Server only: Windows / Active Directory authentication
# USE_WINDOWS_AUTH=true
# SQL_WINDOWS_USER=DOMAIN\username       # optional explicit AD credentials
# SQL_WINDOWS_PASSWORD=your_password

# Databricks only: personal access token and SQL warehouse path
# DB_USER=token
# DB_PASSWORD=your-databricks-token
# DB_EXTRA_SETTINGS=httpPath=/sql/1.0/warehouses/your-warehouse-id

# ---------------------------------------------------------------------------
# Schemas
# ---------------------------------------------------------------------------
# CDM tables (Databricks: catalog.schema, e.g. omop.data)
CDM_SCHEMA=dbo
# Vocabulary (concept table); defaults to CDM_SCHEMA if blank
VOCABULARY_SCHEMA=dbo
# Where results are written (optional)
RESULTS_SCHEMA=dbo

# SQL Server only, when CDM or results live in a different database
# SQL_CDM_DATABASE=cdm_database
# SQL_RESULTS_DATABASE=results_database

# ---------------------------------------------------------------------------
# Output and performance
# ---------------------------------------------------------------------------
OUTPUT_FOLDER=output

# Databricks Arrow transfer (needs full JDBC driver and JVM flags; see .Rprofile)
ENABLE_ARROW=FALSE
# DatabaseConnector bulk upload settings
DATABASE_CONNECTOR_BULK_UPLOAD=TRUE
DATABASE_CONNECTOR_BATCH_SIZE=10000
